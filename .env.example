# Local development only. Do not set this on Railway; Railway provides PORT automatically.
DOXA_BACKEND_PORT=8787
DOXA_BACKEND_ALLOWED_ORIGINS=*
PAYCREST_API_BASE_URL=https://api.paycrest.io/v2
PAYCREST_API_KEY=your_paycrest_api_key_here

# Optional legacy Rails routes. Xchange buy/sell now uses Paycrest.
# RAILS_API_BASE_URL=https://b2b.usetapp.xyz
# RAILS_API_KEY=your_rails_api_key_here
# Sogo Bills: airtime, data, electricity paid by users with USDC.
SOGO_API_BASE_URL=https://api.sogo.africa/v1
SOGO_API_KEY=your_sogo_secret_api_key_here
SOGO_BILLS_QUOTE_SECRET=your_long_random_quote_secret_here
SOGO_BILLS_TREASURY_ADDRESS=your_usdc_collection_wallet_here
# Optional fallback used only when the live USDC/NGN quote endpoint is unavailable.
SOGO_BILLS_USDC_NGN_RATE=1500
# Optional reliable RPC overrides for USDC payment verification.
# SOGO_BILLS_RPC_BNB_CHAIN_URL=
# SOGO_BILLS_RPC_ETHEREUM_URL=
# SOGO_BILLS_RPC_BASE_URL=
# SOGO_BILLS_RPC_ARBITRUM_URL=# Optional USDC decimal overrides. Defaults: BNB Chain 18, Ethereum/Base/Arbitrum 6.
# SOGO_BILLS_USDC_BNB_CHAIN_DECIMALS=18
# SOGO_BILLS_USDC_ETHEREUM_DECIMALS=6
# SOGO_BILLS_USDC_BASE_DECIMALS=6
# SOGO_BILLS_USDC_ARBITRUM_DECIMALS=6